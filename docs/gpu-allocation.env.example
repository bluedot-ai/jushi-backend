# 使用 jushi-api 实际读取的现场环境文件；不要覆盖已有 token、地址和密码。
RESOURCE_TREND_CACHE_ENABLED=true
RESOURCE_TREND_CACHE_24H_REFRESH_SECONDS=900
RESOURCE_TREND_CACHE_7D_REFRESH_SECONDS=3600
RESOURCE_TREND_CACHE_WARMUP_DELAY_SECONDS=2

# 原节点单卡历史保留 14 天；不是新月度分析的半年保留策略。
ACCELERATOR_HISTORY_ENABLED=true
ACCELERATOR_HISTORY_INTERVAL_SECONDS=60
ACCELERATOR_HISTORY_RETENTION_DAYS=14
ACCELERATOR_HISTORY_BACKFILL_SECONDS=5400
ACCELERATOR_HISTORY_CLUSTER_NAME=default

GPU_ALLOCATION_HISTORY_ENABLED=true
GPU_ALLOCATION_INTERVAL_SECONDS=300
GPU_ALLOCATION_CLUSTER_NAME=default
GPU_ALLOCATION_PHYSICAL_RESOURCE_KEY=nvidia.com/gpu
GPU_ALLOCATION_ASCEND_PHYSICAL_RESOURCE_KEYS=huawei.com/Ascend310P
GPU_ALLOCATION_MONITOR_SCRAPE_INTERVAL_SECONDS=30
GPU_ALLOCATION_MONITOR_COVERAGE_FRACTION=0.8
# 两个 exporter 的真实 scrape_interval 可能不同，必须分别核对。
GPU_ALLOCATION_NVIDIA_MONITOR_SCRAPE_INTERVAL_SECONDS=30
GPU_ALLOCATION_ASCEND_MONITOR_SCRAPE_INTERVAL_SECONDS=30
GPU_ALLOCATION_NVIDIA_MEMORY_UNIT=MiB
GPU_ALLOCATION_ASCEND_MEMORY_UNIT=MB
# 上方显存单位来自官方定义，现场 exporter 若输出 MiB，必须改成 MiB 后再比较。
# 如为其他整设备资源，例如 huawei.com/Ascend910B，核验后添加到上方逗号分隔的资源列表。
# 未配置的 Ascend 资源不能被当成不存在；不允许把 vNPU/split 资源加入物理资源列表。
# 默认华为指标选择器为以下三项；只有名称或 job 与现场不同时才启用覆盖项。
# GPU_ALLOCATION_ASCEND_UTILIZATION_PROMQL=npu_chip_info_utilization{job="npu-exporter"}
# GPU_ALLOCATION_ASCEND_MEMORY_USED_PROMQL=npu_chip_info_used_memory{job="npu-exporter"}
# GPU_ALLOCATION_ASCEND_MEMORY_TOTAL_PROMQL=npu_chip_info_total_memory{job="npu-exporter"}
# 覆盖项只允许原始指标选择器；代码固定追加 [5m] 和实际查询时间，不接受预聚合表达式。
# NVIDIA 与 Huawei Ascend 分别采集，虚拟/共享设备不得冒充物理设备数量。
